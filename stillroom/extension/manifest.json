{
  "manifest_version": 3,
  "name": "Stillroom",
  "version": "0.1.1",
  "description": "Collects one small Instagram digest per day for the Stillroom chat.",
  "key": "",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://stillroom-instagram-digest.mildtitan4.chatgpt.site/*",
      "https://stillroom.yildirimozen.com/*",
      "https://yildirimozen.com/stillroom/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  }
}
